{
    "name": "mi-granjita",
    "version": "0.1.0",
    "private": true,
    "description": "Cuida tu granja: siembra, cosecha y cuida a tus animales.",
    "type": "module",
    "scripts": {
        "dev": "vite --config vite/config.dev.mjs",
        "build": "vite build --config vite/config.prod.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "validate": "node ../../scripts/validate-game.mjs .",
        "agent-check": "npm run typecheck && npm run lint && npm run test && npm run validate && npm run build",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "phaser": "^3.87.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@playwright/test": "^1.48.2",
        "eslint": "^9.13.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.3.3",
        "rollup": "^4.22.4",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.11.0",
        "vite": "^5.4.8",
        "vitest": "^2.1.4"
    }
}
